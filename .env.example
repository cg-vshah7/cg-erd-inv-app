# =============================================================================
# CG ERD Inventory App — Environment Variables
# Copy this file to .env and fill in the values before running.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=erd_inv
POSTGRES_USER=erd_inv_user
POSTGRES_PASSWORD=change_me_db_password

# Full async DSN used by the FastAPI backend (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://erd_inv_user:change_me_db_password@postgres:5432/erd_inv

# For local backend dev (host.docker.internal or localhost when PG is in Docker)
# DATABASE_URL=postgresql+asyncpg://erd_inv_user:change_me_db_password@localhost:5432/erd_inv

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
# Base URL reachable by the backend container (internal Docker network)
KEYCLOAK_URL=http://keycloak:8080

# For local backend dev (Keycloak running in Docker, backend running on host)
# KEYCLOAK_URL=http://localhost:8080

KEYCLOAK_REALM=erd-inv
KEYCLOAK_CLIENT_ID=erd-inv-backend
KEYCLOAK_CLIENT_SECRET=change-me-in-production

# Keycloak Admin REST API credentials (used by backend to provision users)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Admin1234!

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Application environment: development | production
APP_ENV=development

# Secret key for signing (used for any internal token generation if needed)
SECRET_KEY=change_me_to_a_long_random_secret

# -----------------------------------------------------------------------------
# Frontend (Vite — VITE_ prefix required for browser exposure)
# -----------------------------------------------------------------------------
# Keycloak base URL reachable from the browser
VITE_KEYCLOAK_URL=http://localhost:8080

VITE_KEYCLOAK_REALM=erd-inv
VITE_KEYCLOAK_CLIENT_ID=erd-inv-frontend

# Backend API base URL (empty = use Vite proxy in dev, set to full URL in prod)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=%(protocol)s://%(domain)s/grafana
GF_SERVER_SERVE_FROM_SUB_PATH=true
